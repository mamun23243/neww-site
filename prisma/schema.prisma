datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum Tier {
  FREE
  PREMIUM
}

enum MoodMode {
  NORMAL
  ROMANTIC
  ADULT
}

model User {
  id               String      @id @default(cuid())
  name             String?
  email            String      @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             Role        @default(USER)
  tier             Tier        @default(FREE)
  isAgeVerified    Boolean     @default(false)
  dateOfBirth      DateTime?
  stripeCustomerId String?     @unique
  stripeSubId      String?     @unique
  dailyMsgCount    Int         @default(0)
  lastMsgReset     DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  accounts         Account[]
  sessions         Session[]
  characters       Character[] @relation("UserCustomCharacters")
  chats            Chat[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Character {
  id           String    @id @default(cuid())
  name         String
  tagline      String
  avatar       String
  backstory    String    @db.Text
  personality  String    @db.Text
  greeting     String    @db.Text
  isPrebuilt   Boolean   @default(true)
  isNsfw       Boolean   @default(false)
  creatorId    String?
  createdAt    DateTime  @default(now())

  creator      User?     @relation("UserCustomCharacters", fields: [creatorId], references: [id])
  chats        Chat[]
}

model Chat {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  currentMood MoodMode  @default(NORMAL)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages    Message[]
  summary     MemorySummary?

  @@unique([userId, characterId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  sender    String   // "user" or "assistant"
  content   String   @db.Text
  mood      MoodMode @default(NORMAL)
  createdAt DateTime @default(now())

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model MemorySummary {
  id        String   @id @default(cuid())
  chatId    String   @unique
  summary   String   @db.Text
  updatedAt DateTime @updatedAt

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}
